{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "munhub-api",
  "main": "src/worker.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "api.munhub.in", "custom_domain": true },
    // Explicit route as well as the Custom Domain: munhub-web's zone-wide
    // `*.munhub.in/*` route otherwise intermittently served api.munhub.in
    // (a Custom Domain does not automatically beat a wildcard route).
    { "pattern": "api.munhub.in/*", "zone_name": "munhub.in" }
  ],
  "vars": {
    // Non-secret config only. Secrets (DATABASE_URL, PAYMENT_FIELD_KEY,
    // TOTP_FIELD_KEY, MOCK_PAYMENT_WEBHOOK_SECRET, GURUPAY_API_KEY, etc. —
    // see .dev.vars.example) must be set via `wrangler secret put <NAME>`,
    // never committed here. REQUIRE_STAFF_2FA (lib/actions/staff-mfa.ts) is a
    // plain var, not a secret, but is deliberately left out of this file —
    // staff sign-in stays 2FA-optional until every staff account has
    // enrolled and it's turned on here explicitly.
    "COOKIE_DOMAIN": ".munhub.in",
    // Extra exact origins only. The production web hosts are built in
    // (server/lib/origins.ts); localhost is trusted only with
    // ALLOW_LOCALHOST_ORIGINS=true, which must never be set here.
    "CORS_ORIGINS": "",
    "ZEPTOMAIL_FROM_ADDRESS": "noreply@munhub.in",
    // The canonical web host. The apex only redirects to www, so links in
    // emails (reset, verification, support replies) point straight at www.
    "APP_URL": "https://www.munhub.in",
    // Origin used in uploaded-file URLs (lib/storage/keys.ts#publicFileUrl);
    // the web app loads them cross-origin from here.
    "PUBLIC_API_URL": "https://api.munhub.in",
    "COOKIE_SECURE": "true",
    // GuruPay is the live payment gateway (docs/payments/SPEC.md);
    // GURUPAY_API_KEY is a secret — `wrangler secret put GURUPAY_API_KEY`,
    // never a var, never committed here.
    "PAYMENTS_ADAPTER": "gurupay",
    // Platform fee (lib/payments/fees-additive.ts#computeFeeBreakdownAdditive):
    // 6.5% of the registration price, plus 18% GST on that fee — ADDITIVE as
    // of the GuruPay rollout (charged to the student on top of the listed
    // price; the organizer receives the full listed price, unchanged). 650bps
    // (6.5%) is the confirmed platform fee rate for this additive GuruPay
    // model (confirmed 2026-09-18, distinct from the old subtractive-model
    // rate this replaced).
    "PLATFORM_FEE_BPS": "650",
    "PLATFORM_FEE_TAX_BPS": "1800",
    // Telegram support notifications (lib/actions/telegram.ts) — the bot's
    // @username, used to build the "Link Telegram" deep link. The bot token
    // and webhook secret are secrets (`wrangler secret put`), not here.
    "TELEGRAM_BOT_USERNAME": "munhub_bot"
  },
  // Workers Rate Limiting bindings, one per limit in
  // server/middleware/rate-limit.ts's LIMITERS (same name, limit and period —
  // a test checks they agree). Counters are shared across isolates within a
  // Cloudflare location; period must be 10 or 60 seconds. namespace_id only
  // has to be unique within the Cloudflare account. Not inherited by
  // env.staging, which repeats the list with its own ids (2001+) so staging
  // traffic never counts against production.
  "ratelimits": [
    { "name": "RL_GLOBAL_IP", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } },
    { "name": "RL_LOGIN_IP", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_LOGIN_ACCOUNT", "namespace_id": "1003", "simple": { "limit": 5, "period": 60 } },
    { "name": "RL_SIGNUP_IP", "namespace_id": "1004", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_RESET_REQUEST_IP", "namespace_id": "1005", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_RESET_REQUEST_EMAIL", "namespace_id": "1006", "simple": { "limit": 3, "period": 60 } },
    { "name": "RL_RESET_CONFIRM_IP", "namespace_id": "1007", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_CHANGE_PASSWORD_USER", "namespace_id": "1008", "simple": { "limit": 5, "period": 60 } },
    { "name": "RL_ORGANIZER_CODE_IP", "namespace_id": "1009", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_ORGANIZER_CODE_IP_EMAIL", "namespace_id": "1010", "simple": { "limit": 3, "period": 60 } },
    { "name": "RL_ORGANIZER_VERIFY_IP_EMAIL", "namespace_id": "1011", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_REGISTRATIONS_USER", "namespace_id": "1012", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_AVAILABILITY_IP", "namespace_id": "1013", "simple": { "limit": 60, "period": 60 } },
    { "name": "RL_MUNS_LIST_IP", "namespace_id": "1014", "simple": { "limit": 120, "period": 60 } },
    { "name": "RL_MFA_VERIFY_IP", "namespace_id": "1015", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_MFA_VERIFY_TOKEN", "namespace_id": "1016", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_SUPPORT_TICKET_USER", "namespace_id": "1017", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_SUPPORT_MESSAGE_USER", "namespace_id": "1018", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_ACCOUNT_DELETE_USER", "namespace_id": "1019", "simple": { "limit": 5, "period": 60 } },
    { "name": "RL_MFA_MANAGE_USER", "namespace_id": "1020", "simple": { "limit": 5, "period": 60 } },
    { "name": "RL_FILES_IP", "namespace_id": "1021", "simple": { "limit": 1200, "period": 60 } },
    { "name": "RL_VERIFY_RESEND_IP", "namespace_id": "1022", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_VERIFY_RESEND_EMAIL", "namespace_id": "1023", "simple": { "limit": 3, "period": 60 } },
    { "name": "RL_UPLOADS_USER", "namespace_id": "1024", "simple": { "limit": 30, "period": 60 } },
    // Payments webhook (server/routes/webhooks.ts) — mounted outside /api/v1
    // and applied directly in that route, not via rateLimitMiddleware's RULES
    // table. See server/middleware/rate-limit.ts's LIMITERS.webhooksPaymentsIp.
    { "name": "RL_WEBHOOKS_PAYMENTS_IP", "namespace_id": "1025", "simple": { "limit": 60, "period": 60 } }
  ],
  // Hyperdrive config "munhub-db", created 2026-09-17 against the production
  // Neon instance. Pools/terminates Postgres connections at Cloudflare's edge
  // so Worker isolates don't each hold their own Neon connection.
  // Local Node dev (server/src/index.ts, `npm run dev`) does not use this at
  // all and is unaffected — see lib/db/client.ts's connection-string resolver.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "d3d1e91bf3474e2988f7524362979a8e"
    }
  ],
  // Uploaded files (organizer logos, covers, PDF documents) — see
  // lib/storage/select-adapter.ts. R2 enabled + bucket created 2026-09-17.
  // No UPLOADS_KV binding was ever added (the namespace was never created —
  // production had zero successful uploads before this), so there is no KV
  // fallback data to preserve; R2 alone is the whole story here. If a KV
  // namespace is ever created later for some other reason, uncomment a
  // kv_namespaces block with binding "UPLOADS_KV" and the adapter will use it
  // as a read fallback automatically (see the adapter's own doc comment).
  "r2_buckets": [
    {
      "binding": "UPLOADS_BUCKET",
      "bucket_name": "munhub-uploads"
    }
  ],
  "observability": {
    "enabled": true
  },
  // Cron trigger → the `scheduled` export in src/worker.ts, which runs every
  // job in lib/jobs/registry.ts. Every 5 minutes: a seat hold lasts 15
  // minutes, so an expired hold is released at most ~5 minutes late.
  // Inherited by env.staging.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  // Named environments. `wrangler deploy --env staging` deploys a separate
  // Worker, munhub-api-staging, reachable only on workers.dev.
  // See docs/operations/ENVIRONMENTS.md.
  "env": {
    "staging": {
      // Routes are inherited from the top level unless overridden. The empty
      // list keeps staging off every munhub.in hostname.
      "routes": [],
      "workers_dev": true,
      // `vars`, `hyperdrive` and `ratelimits` are never inherited; staging
      // lists its own.
      "vars": {
        // Empty on purpose: workers.dev is a public suffix, so the session
        // cookie has to stay host-only.
        "COOKIE_DOMAIN": "",
        "CORS_ORIGINS": "https://munhub-web-staging.somapujith.workers.dev",
        // Only used when a ZEPTOMAIL_TOKEN secret is set on staging; leave
        // that unset and mail goes to the log instead.
        "ZEPTOMAIL_FROM_ADDRESS": "noreply@munhub.in",
        "APP_URL": "https://munhub-web-staging.somapujith.workers.dev",
        // Origin used in uploaded-file URLs: the staging API itself.
        "PUBLIC_API_URL": "https://munhub-api-staging.somapujith.workers.dev",
        // workers.dev is served over HTTPS, same as production.
        "COOKIE_SECURE": "true",
        // 650bps (6.5%) — same confirmed additive GuruPay platform fee rate as
        // production (see the top-level PLATFORM_FEE_BPS comment).
        "PLATFORM_FEE_BPS": "650",
        "PLATFORM_FEE_TAX_BPS": "1800"
      },
      // Bindings are never inherited: leaving these out would deploy
      // munhub-api-staging with no RL_* bindings at all, and every limit would
      // silently fall back to the per-isolate in-memory counter
      // (server/lib/rate-limit-store.ts), which resets with each new isolate.
      // Staging is publicly reachable on workers.dev and its Neon branch is
      // forked from production, so its sign-in limits have to be real. Same
      // names, limits and periods as the top level (a test checks that), with
      // their own namespace ids in the 2000 range so staging counters never
      // share a bucket with production's.
      "ratelimits": [
        { "name": "RL_GLOBAL_IP", "namespace_id": "2001", "simple": { "limit": 300, "period": 60 } },
        { "name": "RL_LOGIN_IP", "namespace_id": "2002", "simple": { "limit": 20, "period": 60 } },
        { "name": "RL_LOGIN_ACCOUNT", "namespace_id": "2003", "simple": { "limit": 5, "period": 60 } },
        { "name": "RL_SIGNUP_IP", "namespace_id": "2004", "simple": { "limit": 10, "period": 60 } },
        { "name": "RL_RESET_REQUEST_IP", "namespace_id": "2005", "simple": { "limit": 10, "period": 60 } },
        { "name": "RL_RESET_REQUEST_EMAIL", "namespace_id": "2006", "simple": { "limit": 3, "period": 60 } },
        { "name": "RL_RESET_CONFIRM_IP", "namespace_id": "2007", "simple": { "limit": 10, "period": 60 } },
        { "name": "RL_CHANGE_PASSWORD_USER", "namespace_id": "2008", "simple": { "limit": 5, "period": 60 } },
        { "name": "RL_ORGANIZER_CODE_IP", "namespace_id": "2009", "simple": { "limit": 30, "period": 60 } },
        { "name": "RL_ORGANIZER_CODE_IP_EMAIL", "namespace_id": "2010", "simple": { "limit": 3, "period": 60 } },
        { "name": "RL_ORGANIZER_VERIFY_IP_EMAIL", "namespace_id": "2011", "simple": { "limit": 10, "period": 60 } },
        { "name": "RL_REGISTRATIONS_USER", "namespace_id": "2012", "simple": { "limit": 10, "period": 60 } },
        { "name": "RL_AVAILABILITY_IP", "namespace_id": "2013", "simple": { "limit": 60, "period": 60 } },
        { "name": "RL_MUNS_LIST_IP", "namespace_id": "2014", "simple": { "limit": 120, "period": 60 } },
        { "name": "RL_MFA_VERIFY_IP", "namespace_id": "2015", "simple": { "limit": 20, "period": 60 } },
        { "name": "RL_MFA_VERIFY_TOKEN", "namespace_id": "2016", "simple": { "limit": 10, "period": 60 } },
        { "name": "RL_SUPPORT_TICKET_USER", "namespace_id": "2017", "simple": { "limit": 10, "period": 60 } },
        { "name": "RL_SUPPORT_MESSAGE_USER", "namespace_id": "2018", "simple": { "limit": 30, "period": 60 } },
        { "name": "RL_ACCOUNT_DELETE_USER", "namespace_id": "2019", "simple": { "limit": 5, "period": 60 } },
        { "name": "RL_MFA_MANAGE_USER", "namespace_id": "2020", "simple": { "limit": 5, "period": 60 } },
        { "name": "RL_FILES_IP", "namespace_id": "2021", "simple": { "limit": 1200, "period": 60 } },
        { "name": "RL_VERIFY_RESEND_IP", "namespace_id": "2022", "simple": { "limit": 10, "period": 60 } },
        { "name": "RL_VERIFY_RESEND_EMAIL", "namespace_id": "2023", "simple": { "limit": 3, "period": 60 } },
        { "name": "RL_UPLOADS_USER", "namespace_id": "2024", "simple": { "limit": 30, "period": 60 } },
        { "name": "RL_WEBHOOKS_PAYMENTS_IP", "namespace_id": "2025", "simple": { "limit": 60, "period": 60 } }
      ],
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          // TODO(staging): placeholder. Create a Hyperdrive config that points
          // at the STAGING Neon branch (never the production branch):
          //   npx wrangler hyperdrive create munhub-db-staging --connection-string="<staging branch URL>"
          // then paste its id here. Deploying staging fails until then.
          "id": "00000000000000000000000000000000"
        }
      ]
    }
  }
}
