{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "munhub-api",
  "main": "src/worker.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "api.munhub.in", "custom_domain": true }
  ],
  "vars": {
    // Non-secret config only. Secrets (DATABASE_URL, PAYMENT_FIELD_KEY,
    // MOCK_PAYMENT_WEBHOOK_SECRET, etc. — see .dev.vars.example) must be set
    // via `wrangler secret put <NAME>`, never committed here.
    "COOKIE_DOMAIN": ".munhub.in",
    "CORS_ORIGINS": "http://localhost:5173,http://localhost:5174,http://localhost:3000",
    "ZEPTOMAIL_FROM_ADDRESS": "noreply@munhub.in",
    "APP_URL": "https://munhub.in",
    // Origin used in uploaded-file URLs (lib/storage/keys.ts#publicFileUrl);
    // the web app loads them cross-origin from here.
    "PUBLIC_API_URL": "https://api.munhub.in"
  },
  // Hyperdrive config "munhub-db", created 2026-09-17 against the production
  // Neon instance. Pools/terminates Postgres connections at Cloudflare's edge
  // so Worker isolates don't each hold their own Neon connection.
  // Local Node dev (server/src/index.ts, `npm run dev`) does not use this at
  // all and is unaffected — see lib/db/client.ts's connection-string resolver.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "d3d1e91bf3474e2988f7524362979a8e"
    }
  ],
  // Uploaded files (organizer logos, covers, PDF documents) — see
  // lib/storage/select-adapter.ts. R2 is not enabled on the account yet, so
  // uploads go to Workers KV. Before deploying, create the namespace and
  // paste its id here:
  //   npx wrangler kv namespace create munhub-uploads
  "kv_namespaces": [
    {
      "binding": "UPLOADS_KV",
      "id": "REPLACE_WITH_UPLOADS_KV_ID"
    }
  ],
  // Once R2 is enabled (`npx wrangler r2 bucket create munhub-uploads`),
  // uncomment this and keep UPLOADS_KV: new uploads then go to R2, and files
  // already in KV are still served (reads fall back to KV). See
  // docs/autonomous-run/changes/lane-storage.md.
  // "r2_buckets": [
  //   {
  //     "binding": "UPLOADS_BUCKET",
  //     "bucket_name": "munhub-uploads"
  //   }
  // ],
  "observability": {
    "enabled": true
  }
}
