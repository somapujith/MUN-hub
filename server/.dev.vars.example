# Local secrets and var overrides for `wrangler dev` (munhub-api in workerd).
# Copy to server/.dev.vars (gitignored). Values here override `vars` from
# wrangler.jsonc during `wrangler dev` only; deployed Workers use
# `wrangler secret put` instead (docs/operations/RUNBOOK.md).
#
# LOCAL VALUES ONLY. Never paste production secrets here.
#
# The database is not configured here: the Worker reaches Postgres through
# its HYPERDRIVE binding. Point that binding at Docker when starting wrangler:
#   CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE="postgresql://mun_hub:mun_hub_dev@localhost:5432/mun_hub" \
#     npx wrangler dev --env="" --test-scheduled
# (--test-scheduled exposes /__scheduled for triggering the cron jobs.)

# wrangler.jsonc sets production values for these; override them locally.
COOKIE_DOMAIN=""
CORS_ORIGINS="http://localhost:5174,http://localhost:5173"
APP_URL="http://localhost:5174"

# Required: base64 of 32 random bytes (a local key, never production's).
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PAYMENT_FIELD_KEY="REPLACE_WITH_BASE64_32_BYTE_KEY"
# Mock payment provider webhook secret (dev/test only).
MOCK_PAYMENT_WEBHOOK_SECRET="dev-webhook-secret-change-me"

# Empty = emails (sign-in codes, reset links) are only written to the log.
ZEPTOMAIL_TOKEN=""

# Optional
# Uploads are refused (503) while wrangler.jsonc's UPLOADS_KV binding is
# commented out. Uncomment it (wrangler dev simulates KV locally), or set this
# to accept uploads and discard the bytes:
# STORAGE_ADAPTER="mock"
# RATE_LIMIT_GLOBAL_PER_MINUTE="300"
# TRUST_PROXY_HEADERS=""
# SENTRY_DSN=""
# SENTRY_ENVIRONMENT="development"

# Local http only; never set these on a deployed Worker. Without the first the
# mock checkout is off; the second overrides wrangler.jsonc's production
# COOKIE_SECURE="true" so the session cookie isn't marked Secure over http.
MOCK_PAYMENTS_ENABLED="true"
COOKIE_SECURE="false"
# Trusts http://localhost:<any port> for CORS/CSRF, instead of listing ports above.
# ALLOW_LOCALHOST_ORIGINS="true"

# Payments (docs/payments/INTEGRATION.md)
# PAYMENTS_ADAPTER="mock"
# PLATFORM_FEE_BPS="0"
# PLATFORM_FEE_TAX_BPS="1800"
# PAYMENT_FIELD_KEY_PREVIOUS=""       # decrypt-only key during a rotation

# Scheduled jobs: users.id of a local staff account. Unset, the lifecycle job
# skips; trigger a run with: curl "http://localhost:8787/__scheduled?cron=*/5+*+*+*+*"
# SYSTEM_ACTOR_USER_ID=""

# Other optional settings
# REQUIRE_EMAIL_VERIFICATION=""       # "true" blocks registration until the email is verified
# CHECKIN_CODE_SECRET=""              # >= 32 chars; unset = derived from PAYMENT_FIELD_KEY
# TURNSTILE_SECRET_KEY=""             # only together with the web build's VITE_TURNSTILE_SITE_KEY
# RATE_LIMIT_IP_MULTIPLIER=""         # scales per-IP limits in the in-memory fallback only
# EMAIL_OUTBOX_FILE=""                # append each logged email to this file as a JSON line
