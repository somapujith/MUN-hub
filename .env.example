DATABASE_URL="postgresql://mun_hub:mun_hub_dev@localhost:5432/mun_hub"
# Swap to Neon connection string for cloud/staging/prod — no schema changes needed.
# NEON_API_KEY="neon_api_key_placeholder"
# DATABASE_URL="postgresql://<user>:<password>@<neon-host>.neon.tech/<db>?sslmode=require"
MOCK_PAYMENT_WEBHOOK_SECRET="dev-webhook-secret-change-me"
# Base URL for server-side loopback calls (e.g. the mock checkout page
# posting to /api/webhooks/payments). Must be set explicitly in any
# deployed environment (Cloudflare Workers has no implicit localhost) —
# defaulting to http://localhost:3000 only works in local dev.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Read via getRuntimeEnv('APP_URL') by lib/notifications/resolve-recipients.ts
# for links in outgoing emails (Workers never populate process.env with
# custom vars, so this is separate from NEXT_PUBLIC_APP_URL above). Same
# value as NEXT_PUBLIC_APP_URL until the Next-era var name is retired.
APP_URL="http://localhost:3000"
AUTH_ADAPTER="mock"
PAYMENTS_ADAPTER="mock"
# Where uploaded files (logos, covers, PDFs) go when the API runs on Node
# (lib/storage/select-adapter.ts). On Cloudflare the UPLOADS_KV /
# UPLOADS_BUCKET bindings are used instead and this is ignored.
#   local — write to .local-uploads/ at the repo root (gitignored; override
#           with LOCAL_UPLOADS_DIR). Use this for local dev so uploads show up.
#   mock  — keep nothing (what .env.test uses). Uploaded files then 404.
STORAGE_ADAPTER="local"
# LOCAL_UPLOADS_DIR=".local-uploads"
# Origin put in front of /api/v1/files/<key> in uploaded-file URLs. Leave
# unset locally: the API then uses the origin of the upload request
# (http://localhost:3001). Production sets it in server/wrangler.jsonc.
# PUBLIC_API_URL="https://api.munhub.in"
# AES-256-GCM key for lib/crypto/field-encryption.ts (payment field
# encryption) — must be a base64-encoded 32-byte value, e.g. generated via
# `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`.
# No default/fallback exists — the app throws at startup without a valid key.
PAYMENT_FIELD_KEY="REPLACE_WITH_BASE64_32_BYTE_KEY"
# Real email delivery (lib/notifications/zeptomail-adapter.ts). Leave unset
# for local dev/tests — lib/notifications/select-adapter.ts falls back to
# the console/mock adapter whenever ZEPTOMAIL_TOKEN is empty. ZEPTOMAIL_TOKEN
# is the Send Mail Token from the ZeptoMail dashboard; ZEPTOMAIL_FROM_ADDRESS
# must be a sending address on a domain verified in ZeptoMail.
ZEPTOMAIL_TOKEN=""
ZEPTOMAIL_FROM_ADDRESS=""
