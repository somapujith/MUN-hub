# MUN Hub: local environment template.
#
# Copy to server/.env for the Node API:
#   cd server && npx tsx --env-file=.env src/index.ts
# (`wrangler dev` reads server/.dev.vars instead; template:
# server/.dev.vars.example.) Tests don't use this file: Vitest loads the
# committed .env.test.
#
# LOCAL VALUES ONLY. Never put the production Neon URL or production secrets
# in a file the local API reads. See docs/operations/ENVIRONMENTS.md.
# On Cloudflare, vars live in wrangler.jsonc and secrets are set with
# `wrangler secret put` (docs/operations/RUNBOOK.md). Workers never expose
# them via process.env, so server code reads them with getRuntimeEnv().

# --- Database -----------------------------------------------------------------
# Docker Postgres from docker-compose.yml (`npm run db:up`). Read by the Node
# API, lib/db/migrate.ts, lib/db/seed.ts and drizzle.config.ts. The deployed
# Worker ignores it and connects through its HYPERDRIVE binding.
DATABASE_URL="postgresql://mun_hub:mun_hub_dev@localhost:5432/mun_hub"
# lib/db/seed.ts refuses a non-local DATABASE_URL unless this is "true".
ALLOW_REMOTE_SEED=""
# scripts/create-admin.ts has the same guard. Set it only for the one run
# that bootstraps a remote super admin, never in this file.
# ALLOW_REMOTE_ADMIN_BOOTSTRAP=""

# --- Node API ---------------------------------------------------------------
# Listen port for server/src/index.ts (default 3001).
PORT="3001"
# Browser origins trusted by CORS and the CSRF check (server/lib/origins.ts).
# The production web hosts are built in. ALLOW_LOCALHOST_ORIGINS="true"
# trusts http://localhost:<any port> (the web dev server runs on :5174) and
# must never be set in a deployed environment. CORS_ORIGINS adds extra exact
# origins, comma-separated; ALLOWED_ORIGINS is an older alias.
ALLOW_LOCALHOST_ORIGINS="true"
CORS_ORIGINS=""
# Session cookie domain. Leave empty locally (host-only cookie); production
# uses ".munhub.in".
COOKIE_DOMAIN=""
# Per-IP request cap per minute for routes without a dedicated limit
# (default 300).
# RATE_LIMIT_GLOBAL_PER_MINUTE="300"
# "true" only behind a proxy you trust to set X-Forwarded-For.
# TRUST_PROXY_HEADERS=""
# Only checked when NODE_ENV=production under Node (server/lib/boot-guard.ts),
# which refuses to start while this is unset or "mock". The Worker doesn't
# run that check.
AUTH_ADAPTER="mock"

# --- Auth hardening (docs/autonomous-run/changes/lane-sec-auth.md) -------------
# COOKIE_SECURE: "true"/"false" forces the session cookie's Secure flag;
# unset = Secure except on plain-http localhost. Production sets "true".
COOKIE_SECURE=""
# Cloudflare Turnstile on delegate signup + organizer code requests. Leave
# empty to disable; set together with web's VITE_TURNSTILE_SITE_KEY.
TURNSTILE_SECRET_KEY=""
# Multiplies per-IP rate limits in the in-memory fallback (never the Workers
# bindings). For local suites where every request comes from 127.0.0.1.
RATE_LIMIT_IP_MULTIPLIER=""

# --- File uploads ---------------------------------------------------------------
# Where uploaded files (logos, covers, PDFs) go when the API runs on Node
# (lib/storage/select-adapter.ts). On Cloudflare the UPLOADS_KV /
# UPLOADS_BUCKET bindings are used instead and this is ignored.
#   local — write to .local-uploads/ at the repo root (gitignored; override
#           with LOCAL_UPLOADS_DIR). Use this for local dev so uploads show up.
#   mock  — keep nothing (what .env.test uses). Uploaded files then 404.
# Leave it unset and uploads are refused with 503 instead of being discarded.
STORAGE_ADAPTER="local"
# LOCAL_UPLOADS_DIR=".local-uploads"
# Origin put in front of /api/v1/files/<key> in uploaded-file URLs. Leave
# unset locally: the API then uses the origin of the upload request
# (http://localhost:3001). Production sets it in server/wrangler.jsonc.
# PUBLIC_API_URL="https://api.munhub.in"

# --- Links in emails ------------------------------------------------------------
# Public site URL used to build links in outgoing emails.
APP_URL="http://localhost:5174"
# Older name, still read as a fallback (resolve-recipients.ts) and by the
# sitemap route. Keep it equal to APP_URL.
NEXT_PUBLIC_APP_URL="http://localhost:5174"

# --- Email (ZeptoMail) ----------------------------------------------------------
# Leave the token empty locally: emails, including organizer sign-in codes
# and password-reset links, are then printed to the API console.
ZEPTOMAIL_TOKEN=""
# Sender address on a domain verified in ZeptoMail.
ZEPTOMAIL_FROM_ADDRESS=""

# --- Payments -------------------------------------------------------------------
# AES-256-GCM key for payout details (lib/crypto/field-encryption.ts): base64
# of exactly 32 random bytes. No default: payout settings fail without it.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PAYMENT_FIELD_KEY="REPLACE_WITH_BASE64_32_BYTE_KEY"
# Key rotation: move the old key here (decrypt-only) and put the new one in
# PAYMENT_FIELD_KEY. Leave empty when not rotating.
PAYMENT_FIELD_KEY_PREVIOUS=""

# --- Staff two-factor auth -------------------------------------------------------
# Separate AES-256-GCM key for staff TOTP secrets (lib/actions/staff-mfa.ts) —
# same format as PAYMENT_FIELD_KEY, deliberately a different key so the two
# blast radii stay separate. No default: enrollment fails without it.
TOTP_FIELD_KEY="REPLACE_WITH_BASE64_32_BYTE_KEY"
TOTP_FIELD_KEY_PREVIOUS=""
# When "true", requireRole (server/middleware/require-role.ts) blocks every
# staff-role-gated route for an OPERATIONS/ADMIN/SUPER_ADMIN account that
# hasn't confirmed TOTP enrollment. Unset (the default) leaves staff sign-in
# exactly as it was before 2FA existed.
REQUIRE_STAFF_2FA=""
# HMAC secret for the mock payment provider's webhook (dev/test only).
MOCK_PAYMENT_WEBHOOK_SECRET="dev-webhook-secret-change-me"
# Payment provider (lib/payments/registry.ts, docs/payments/CASHFREE.md —
# Cashfree is the shipped live gateway; docs/payments/INTEGRATION.md's
# Razorpay recipe and docs/payments/SPEC.md's GuruPay integration were never
# kept — Cashfree is the current target provider). PAYMENTS_ADAPTER picks it
# (default "mock"). The mock confirms registrations without real money, so it
# only works when MOCK_PAYMENTS_ENABLED is exactly "true": local dev/tests
# ONLY, never on a deployed Worker. With no usable adapter, paid passes are
# refused with PAYMENTS_UNAVAILABLE and free passes still work. Set
# PAYMENTS_ADAPTER="cashfree" plus CASHFREE_CLIENT_ID/CASHFREE_CLIENT_SECRET
# below to use the live gateway locally.
PAYMENTS_ADAPTER="mock"
MOCK_PAYMENTS_ENABLED="true"
# Cashfree's API credentials (lib/payments/cashfree-adapter.ts), read
# exclusively via getRuntimeEnv — never process.env — anywhere in /server or
# /lib. Never real values here: production sets them with
# `wrangler secret put CASHFREE_CLIENT_ID` / `CASHFREE_CLIENT_SECRET`.
CASHFREE_CLIENT_ID="REPLACE_WITH_CLIENT_ID"
CASHFREE_CLIENT_SECRET="REPLACE_WITH_CLIENT_SECRET"
# "sandbox" or "production" — picks Cashfree's API base URL. Default: production.
CASHFREE_ENV="production"
# Platform fee, in basis points. ADDITIVE model: charged to the student ON
# TOP OF the listed price, not deducted from it — the organizer always
# receives the full listed price. PLATFORM_FEE_TAX_BPS is GST charged on the
# fee. 650 = 6.5%, the confirmed production rate.
PLATFORM_FEE_BPS="650"
PLATFORM_FEE_TAX_BPS="1800"

# --- Error reporting (server/lib/report-error.ts) ------------------------------
# Optional. With a DSN, unexpected errors are also sent to Sentry.
# SENTRY_DSN=""
# SENTRY_ENVIRONMENT="development"
# SENTRY_RELEASE=""

# --- Scheduled jobs (lib/jobs/registry.ts) --------------------------------------
# users.id of a dedicated staff account, recorded as the actor of the automatic
# open-registration / close-registration / start-conference moves. Unset: that
# job logs a warning and skips; the other jobs still run.
SYSTEM_ACTOR_USER_ID=""

# --- Registration and conference day ----------------------------------------------
# "true" = accounts whose email isn't verified can't register for a MUN.
REQUIRE_EMAIL_VERIFICATION=""
# Signs delegate check-in codes (lib/actions/check-in.ts); at least 32
# characters. Unset: derived from PAYMENT_FIELD_KEY. Changing it (or
# PAYMENT_FIELD_KEY while this is unset) invalidates every issued pass code.
CHECKIN_CODE_SECRET=""
# Dev/E2E only: the console email adapter also appends every message to this
# file as one JSON line. Ignored in production.
EMAIL_OUTBOX_FILE=""
